FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomWall
    {
        type            zeroGradient;
    }
    nozzles
    {
        type            fixedValue;
        value           uniform 1;
    }
    top
    {
        type            zeroGradient;
    }
    sludgeInlet
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0       1)
            (0.1     1)
            (0.1001  0.99512)
            (1e5     0.99512)
        );
    }
    frontAndBack
    {
        type            empty;
    }
}


// ************************************************************************* //

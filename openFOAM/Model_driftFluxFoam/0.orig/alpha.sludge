FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      alpha.sludge;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    bottomWall
    {
        type            zeroGradient;
    }
    nozzles
    {
        type            fixedValue;
        value           uniform 0;
    }
    top
    {
        type            zeroGradient;
    }
    sludgeInlet
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0       0)
            (0.1     0)
            (0.1001  0.00488)
            (1e5     0.00488)
        );
    }
    frontAndBack
    {
        type            empty;
    }
}


// ************************************************************************* //

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      mu;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0.001;

boundaryField
{
    inlet
    {
        type            calculated;
        value           $internalField;
    }

    outlet
    {
        type            calculated;
        value           $internalField;
    }

    bottomWall
    {
        type            calculated;
        value           $internalField;
    }

    nozzles
    {
        type            calculated;
        value           $internalField;
    }

    sludgeInlet
    {
        type            calculated;
        value           $internalField;
    }

    top
    {
        type            calculated;
        value           $internalField;
    }

    frontAndBack
    {
        type            empty;
    }
}


